      <item row="3" column="0" colspan="2">
       <widget class="QLabel" name="etiquetaCalidad">
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="grupoAudios">
     <property name="title">
      <string>Pistas de audio</string>
     </property>
     <layout class="QVBoxLayout" name="layoutAudios">
      <item>
       <widget class="QLabel" name="etiquetaAudios">
        <property name="text">
         <string>Marcá los idiomas que quieras: quedan todos dentro del video y la primera marcada es la que suena por defecto. Si no marcás ninguno, se baja la pista original.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QListWidget" name="listaAudios"/>
      </item>
      <item>
