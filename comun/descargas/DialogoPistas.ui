      <item>
       <widget class="QListWidget" name="listaSubtitulos"/>
      </item>
      <item>
       <widget class="QCheckBox" name="checkAutomaticos">
        <property name="text">
         <string>Mostrar todas las traducciones automáticas</string>
        </property>
        <property name="toolTip">
         <string>Sin marcar, de los subtítulos automáticos solo se ven los del idioma original y los traducidos al idioma del sistema</string>
