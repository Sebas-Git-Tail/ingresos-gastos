        <item>
         <widget class="QPushButton" name="botonTodosAudios">
          <property name="text">
           <string>Marcar todas</string>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="espacioAudios">
          <property name="orientation">
           <enum>Qt::Orientation::Horizontal</enum>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="grupoSubtitulos">
     <property name="title">
      <string>Subtítulos</string>
     </property>
     <layout class="QVBoxLayout" name="layoutSubtitulos">
