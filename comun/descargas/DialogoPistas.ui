  </property>
  <property name="windowTitle">
   <string>Calidad, códecs, audio y subtítulos</string>
  </property>
  <layout class="QVBoxLayout" name="layoutPrincipal">
   <item>
    <widget class="QGroupBox" name="grupoCalidad">
     <property name="title">
      <string>Calidad y códecs</string>
     </property>
     <layout class="QFormLayout" name="layoutCalidad">
      <item row="0" column="0">
       <widget class="QLabel" name="etiquetaComboCalidad">
        <property name="text">
